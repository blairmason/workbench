#!/bin/sh
# Weekly consolidation pass for ~/src/rnd.
#
# 1. Harvest every Claude project memory namespace into a dated digest.
# 2. Hand the digest to a non-interactive Claude run, in ~/src/rnd, to triage
#    it into topics/ and flag contradictions.
# 3. Commit whatever changed, so the pass is auditable and revertable.
#
# Run by ~/Library/LaunchAgents/com.blairmason.rnd-weekly.plist, or by hand.
#   rnd-weekly            harvest + triage + commit
#   rnd-weekly --dry      harvest only; print the digest path and stop

set -eu

RND="$HOME/src/rnd"
BIN="$HOME/.local/bin"
DATE=$(date +%Y-%m-%d)
DIGEST="$RND/.harvest/$DATE.md"
QUARTER="$(date +%Y)-q$(( ($(date +%-m) - 1) / 3 + 1 ))"

[ -d "$RND" ] || { echo "no $RND — nothing to do" >&2; exit 0; }
mkdir -p "$RND/.harvest"

"$BIN/rnd-harvest" -o "$DIGEST"

if [ "${1:-}" = "--dry" ]; then
  echo "digest: $DIGEST"
  exit 0
fi

command -v claude >/dev/null 2>&1 || { echo "claude CLI not on PATH" >&2; exit 1; }

# --permission-mode acceptEdits: this runs unattended, and the only thing it
# should ever write is notes inside this repo.
cd "$RND"
claude -p --permission-mode acceptEdits "$(cat <<EOF
You are running the weekly R&D consolidation pass in ~/src/rnd. Read
./CLAUDE.md first and follow its filing rules exactly.

A fresh harvest of every Claude project memory namespace is at
$DIGEST. Also read ./inbox.md.

Do this:

1. Triage ./inbox.md top to bottom. Move each entry into the right
   topics/<slug>.md, preferring an APPEND to an existing topic over a new file.
   Remove entries from inbox.md once filed.
2. Work the digest. Skip anything marked "already referenced in rnd", and skip
   repo-local mechanics — those belong in that repo's own memory, not here.
   Anything in an ORPHAN namespace is at risk: file it first.
3. Flag contradictions. If a new finding overturns an existing claim, rewrite
   the claim in place and note the change under the topic's header. Never leave
   both the old and new answer standing.
4. Keep every topic header current: Status, Updated, Sources.
5. Append a dated section to ./roadmap/$QUARTER.md (create it if absent)
   ONLY if something genuinely changes what we should do next quarter. Do not
   invent roadmap items to fill space.
6. Write a short ./.harvest/$DATE-summary.md: what you filed, what you merged,
   what contradicted something, and what you deliberately left alone and why.

Be conservative. If a finding is ambiguous or you cannot tell what it means,
leave it in inbox.md and say so in the summary rather than guessing. Do not
create a topic file for a single thin observation — the inbox is allowed to
hold things until they earn a topic.
EOF
)" >"$RND/.harvest/$DATE-run.log" 2>&1 || {
  echo "claude run failed; see $RND/.harvest/$DATE-run.log" >&2
  exit 1
}

if [ -n "$(git -C "$RND" status --porcelain)" ]; then
  git -C "$RND" add -A
  git -C "$RND" -c user.name="rnd-weekly" -c user.email="blair.mason@uniswap.org" \
    commit -q -m "rnd: weekly consolidation $DATE"
  echo "committed: $(git -C "$RND" log --oneline -1)"
else
  echo "no changes"
fi
