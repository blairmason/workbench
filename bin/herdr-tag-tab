#!/usr/bin/env python3
"""Tag the focused herdr tab with focus / priority / blocked state.

Three INDEPENDENT slots, written as emoji at the front of the tab name:

    focus     ⭐                       at most one tab in the whole session
    priority  🔴 p0  🟡 p1  ⚪ p2      at most one per tab
    blocked   👀 review  ✋ them       any number per tab

    "⭐⚪👀 spike"   focused right now, standing priority p2, waiting on a review
    "🔴 migration"  p0, but not what you're doing this minute

Focus and priority are deliberately separate axes. Priority is how much a thing
matters overall; focus is what you are on *now*. Spending half an hour on a p2
while p0s exist is normal, and starring it must not destroy its p2.

The tab NAME is the source of truth: herdr persists tab names across restarts
but not pane metadata, so `resync` rebuilds every token from the marks.

Usage:
    herdr-tag-tab                  popup picker (multi-select)
    herdr-tag-tab focus|unfocus    ⭐ on/off; focus is exclusive across tabs
    herdr-tag-tab p0|p1|p2         set standing priority
    herdr-tag-tab unprioritise     clear the priority, keep everything else
    herdr-tag-tab review|them      add a blocker
    herdr-tag-tab unblock          clear all blockers
    herdr-tag-tab clear            clear all three slots
    herdr-tag-tab resync           rebuild tokens from marks on every tab
    herdr-tag-tab ... --tab <id>   act on a specific tab, not the focused one
"""
import json
import re
import shutil
import subprocess
import sys

FOCUS = "⭐"
PRIORITY = {"p0": "\U0001F534", "p1": "\U0001F7E1", "p2": "⚪"}
BLOCKED = {"review": "\U0001F440", "them": "✋"}

PRIORITY_BY_MARK = {m: p for p, m in PRIORITY.items()}
BLOCKED_BY_MARK = {m: b for b, m in BLOCKED.items()}
P_MARKS = "".join(PRIORITY.values())
B_MARKS = "".join(BLOCKED.values())

# Position-significant: focus, then priority, then any number of blockers.
MARKS_RE = re.compile(
    r"^(" + FOCUS + r"?)([" + P_MARKS + r"]?)([" + B_MARKS + r"]*)\s*(.*)$", re.S)


def herdr(*args, capture=True):
    r = subprocess.run(["herdr", *args], capture_output=capture, text=True)
    return r.stdout if capture else ""


def jget(*args):
    try:
        return json.loads(herdr(*args))["result"]
    except (ValueError, KeyError):
        return None


def split_marks(label):
    """-> (focus, priority, blockers, bare_name)"""
    m = MARKS_RE.match(label or "")
    if not m:
        return "", "", "", label or ""
    return m.group(1), m.group(2), m.group(3), m.group(4).strip()


def all_tabs():
    out = []
    for w in (jget("workspace", "list") or {}).get("workspaces", []):
        out.extend((jget("tab", "list", "--workspace", w["workspace_id"]) or {})
                   .get("tabs", []))
    return out


def focused_tab_id():
    spaces = (jget("workspace", "list") or {}).get("workspaces", [])
    f = next((w for w in spaces if w.get("focused")), None)
    return f.get("active_tab_id") if f else None


def panes_of(tab_id):
    return [p["pane_id"] for p in (jget("pane", "list") or {}).get("panes", [])
            if p.get("tab_id") == tab_id]


def write_tokens(tab_id, foc, prio, blocked):
    """Mirror the marks into pane tokens. Focus and priority are independent."""
    names = [BLOCKED_BY_MARK[m] for m in (blocked or "") if m in BLOCKED_BY_MARK]
    values = {
        "focus": "NOW" if foc else None,
        "p": PRIORITY_BY_MARK.get(prio),
        "blocked": "+".join(names) if names else None,
    }
    for pid in panes_of(tab_id):
        args = ["pane", "report-metadata", pid, "--source", "herdr-tag-tab"]
        for name, val in values.items():
            args += ["--token", f"{name}={val}"] if val else ["--clear-token", name]
        herdr(*args, capture=False)


def apply(tab_id, label, foc=None, prio=None, blocked=None):
    cf, cp, cb, bare = split_marks(label)
    nf = cf if foc is None else foc
    np = cp if prio is None else prio
    nb = cb if blocked is None else blocked
    name = f"{nf}{np}{nb} {bare}".strip() or bare or tab_id.split(":")[-1]
    herdr("tab", "rename", tab_id, name, capture=False)
    write_tokens(tab_id, nf, np, nb)
    return name


def clear_focus_elsewhere(tab_id):
    """Only one tab is 'now'. Drop the star from others, keep their priority."""
    for t in all_tabs():
        if t["tab_id"] == tab_id:
            continue
        f, _, _, _ = split_marks(t.get("label", ""))
        if f:
            apply(t["tab_id"], t["label"], foc="")


def resync_all():
    n = 0
    for t in all_tabs():
        f, p, b, _ = split_marks(t.get("label", ""))
        if f or p or b:
            write_tokens(t["tab_id"], f, p, b)
            n += 1
    return n


# (display, slot, value); slot is focus | prio | blocked | meta
MENU = [
    (f"{FOCUS}  focus          — what you're on right now", "focus", FOCUS),
    (f"{PRIORITY['p0']}  p0             — standing priority", "prio", PRIORITY["p0"]),
    (f"{PRIORITY['p1']}  p1", "prio", PRIORITY["p1"]),
    (f"{PRIORITY['p2']}  p2             — background", "prio", PRIORITY["p2"]),
    (f"{BLOCKED['review']}  blocked        — waiting on a review", "blocked", BLOCKED["review"]),
    (f"{BLOCKED['them']}  blocked        — waiting on someone", "blocked", BLOCKED["them"]),
    ("·  clear focus", "focus", ""),
    ("·  clear priority", "prio", ""),
    ("·  clear blocked", "blocked", ""),
    ("↻  resync all tabs — rebuild colours from the marks", "meta", None),
]


def describe(foc, prio, blocked):
    bits = []
    if foc:
        bits.append("⭐ focus")
    if prio in PRIORITY_BY_MARK:
        bits.append(f"{prio} {PRIORITY_BY_MARK[prio]}")
    if blocked:
        bits.append(f"{blocked} blocked:"
                    + "+".join(BLOCKED_BY_MARK.get(m, "?") for m in blocked))
    return "  ".join(bits) if bits else "untagged"


def pick(tab_id, label):
    cf, cp, cb, bare = split_marks(label)
    header = (f"{bare or tab_id}\nnow: {describe(cf, cp, cb)}"
              "   ·   space or tab marks ✓   ·   enter applies")
    lines = [d for d, _, _ in MENU]

    if shutil.which("fzf"):
        proc = subprocess.run(
            # fzf binds only Tab to toggle by default; space is bound here so
            # the header's promise is true.
            ["fzf", "--multi", "--reverse", "--height=100%",
             "--marker=✓ ", "--pointer=▸", "--bind", "space:toggle+down",
             "--prompt=label> ", "--header", header],
            input="\n".join(lines), capture_output=True, text=True)
        chosen = [l for l in proc.stdout.splitlines() if l.strip()]
        if not chosen:
            return 130
    else:
        print(header + "\n")
        for i, d in enumerate(lines, 1):
            print(f"{i:2}. {d}")
        try:
            raw = input("\nnumbers (comma-separated, blank to cancel)> ").strip()
        except (EOFError, KeyboardInterrupt):
            return 130
        if not raw:
            return 130
        chosen = []
        for part in raw.split(","):
            try:
                chosen.append(lines[int(part.strip()) - 1])
            except (ValueError, IndexError):
                print(f"ignoring: {part.strip()}", file=sys.stderr)

    by_display = {d: (slot, val) for d, slot, val in MENU}
    foc = prio = blocked = None
    do_resync = False
    for c in chosen:
        hit = by_display.get(c)
        if not hit:
            continue
        slot, val = hit
        if slot == "meta":
            do_resync = True
        elif slot == "focus" and foc is None:
            foc = val
        elif slot == "prio" and prio is None:
            prio = val
        elif slot == "blocked":
            if val == "":
                blocked = ""            # an explicit clear wins
            elif blocked == "":
                continue
            else:
                blocked = (blocked or "") + val

    if do_resync:
        print(f"resynced {resync_all()} tagged tab(s)")
    if foc is None and prio is None and blocked is None:
        return 0 if do_resync else 130
    if foc:
        clear_focus_elsewhere(tab_id)
    print(apply(tab_id, label, foc=foc, prio=prio, blocked=blocked))
    return 0


def main():
    argv = sys.argv[1:]
    explicit = None
    if "--tab" in argv:
        i = argv.index("--tab")
        if i + 1 < len(argv):
            explicit = argv[i + 1]
            del argv[i:i + 2]
    cmd = (argv[0] if argv else "").strip().lower()

    if cmd == "resync":
        print(f"resynced {resync_all()} tagged tab(s)")
        return 0

    tab_id = explicit or focused_tab_id()
    if not tab_id:
        print("no focused tab", file=sys.stderr)
        return 1
    label = ((jget("tab", "get", tab_id) or {}).get("tab", {})).get("label", "")

    if cmd in ("pick", ""):
        return pick(tab_id, label)
    if cmd == "focus":
        clear_focus_elsewhere(tab_id)
        print(apply(tab_id, label, foc=FOCUS))
    elif cmd == "unfocus":
        print(apply(tab_id, label, foc=""))
    elif cmd in PRIORITY:
        print(apply(tab_id, label, prio=PRIORITY[cmd]))
    elif cmd in ("unprioritise", "unprioritize"):
        print(apply(tab_id, label, prio=""))
    elif cmd in BLOCKED:
        cur = split_marks(label)[2]
        add = BLOCKED[cmd]
        print(apply(tab_id, label, blocked=cur if add in cur else cur + add))
    elif cmd == "unblock":
        print(apply(tab_id, label, blocked=""))
    elif cmd == "clear":
        print(apply(tab_id, label, foc="", prio="", blocked=""))
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
