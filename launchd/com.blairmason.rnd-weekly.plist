<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blairmason.rnd-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/blairmason/.local/bin/rnd-weekly</string>
  </array>
  <!-- Monday 08:47. Off the hour on purpose; nothing else competes for it. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>47</integer>
  </dict>
  <!-- If the Mac was asleep at the trigger time, run once on wake. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/rnd-weekly.log</string>
  <key>StandardErrorPath</key><string>/tmp/rnd-weekly.log</string>
  <!-- claude and git must be findable in a launchd context, which has a
       minimal PATH by default. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/blairmason/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
