#!/usr/bin/env python3
"""Harvest Claude project memories into a digest for the R&D repo.

Claude memory is keyed to cwd, so learnings end up spread across one namespace
per repo -- plus throwaway namespaces for every git worktree an agent entered,
which are orphaned when that worktree is removed. This walks all of them and
emits one markdown digest to triage into ~/src/rnd/topics/.

    rnd-harvest                  digest of memories not yet filed in rnd
    rnd-harvest --all            every memory, filed or not
    rnd-harvest --since 2026-09-01
    rnd-harvest --orphans        only worktree namespaces (the at-risk ones)
    rnd-harvest -o FILE          write there instead of stdout

A memory counts as "filed" if its slug appears anywhere under ~/src/rnd.
Nothing is moved or deleted -- this only ever reads.
"""
import argparse
import datetime as dt
import os
import pathlib
import re
import subprocess
import sys

PROJECTS = pathlib.Path.home() / ".claude" / "projects"
RND = pathlib.Path.home() / "src" / "rnd"

# A project dir whose path encodes a worktree: memories here die with the tree.
ORPHAN_RE = re.compile(r"(--claude-worktrees-|-wt-|-worktrees-)")


HOME_PREFIX = str(pathlib.Path.home()).replace("/", "-")  # -> "-Users-blairmason"


def _encode(path):
    return str(path).replace("/", "-")


def _real_dirs():
    """Map encoded project name -> real path, by looking at what exists.

    The encoding replaces "/" with "-", so "baker-bot" and "baker/bot" collide.
    Only the filesystem can disambiguate, so prefer a real directory match and
    fall back to the naive decode.
    """
    home = pathlib.Path.home()
    out = {}
    roots = [home, home / "src"]
    for root in roots:
        if not root.is_dir():
            continue
        out[_encode(root)] = root
        try:
            for d in root.iterdir():
                if d.is_dir():
                    out[_encode(d)] = d
                    # one more level, for worktrees like src/backend-wt/dp136-*
                    try:
                        for dd in d.iterdir():
                            if dd.is_dir():
                                out.setdefault(_encode(dd), dd)
                    except OSError:
                        pass
        except OSError:
            pass
    return out


_REAL = None


def decode_project(name):
    """-Users-blairmason-src-backend -> ~/src/backend (filesystem-checked)."""
    global _REAL
    if _REAL is None:
        _REAL = _real_dirs()
    hit = _REAL.get(name)
    if hit is not None:
        try:
            return "~/" + str(hit.relative_to(pathlib.Path.home())) if hit != pathlib.Path.home() else "~"
        except ValueError:
            return str(hit)
    if name.startswith(HOME_PREFIX):
        rest = name[len(HOME_PREFIX):].lstrip("-")
        return "~/" + rest.replace("-", "/") + "  (unresolved)" if rest else "~"
    return "/" + name.lstrip("-").replace("-", "/") + "  (unresolved)"


def label(name):
    """Short, readable project label."""
    if name == HOME_PREFIX:
        return "~ (home)"
    n = name[len(HOME_PREFIX):].lstrip("-") if name.startswith(HOME_PREFIX) else name
    return n or name


def front_matter(text):
    if not text.startswith("---"):
        return {}, text
    end = text.find("\n---", 3)
    if end == -1:
        return {}, text
    head, body = text[3:end], text[end + 4:]
    meta = {}
    for line in head.splitlines():
        m = re.match(r"^(\w[\w-]*):\s*(.*)$", line.strip())
        if m:
            meta[m.group(1)] = m.group(2).strip()
    return meta, body.strip()


def filed_slugs():
    """Slugs already referenced anywhere under ~/src/rnd."""
    if not RND.exists():
        return set()
    seen = set()
    for f in RND.rglob("*.md"):
        try:
            seen.update(re.findall(r"[a-z0-9]+(?:-[a-z0-9]+){1,}", f.read_text(errors="ignore")))
        except OSError:
            pass
    return seen


def git_first_seen(path):
    """Commit date of a memory file, when the project dir is a git repo."""
    try:
        r = subprocess.run(
            ["git", "-C", str(path.parent), "log", "-1", "--format=%cs", "--", path.name],
            capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or None
    except Exception:
        return None


def collect(args):
    if not PROJECTS.exists():
        print(f"no such directory: {PROJECTS}", file=sys.stderr)
        return []
    already = set() if args.all else filed_slugs()
    out = []
    for proj in sorted(PROJECTS.iterdir()):
        mem = proj / "memory"
        if not mem.is_dir():
            continue
        orphan = bool(ORPHAN_RE.search(proj.name))
        if args.orphans and not orphan:
            continue
        for f in sorted(mem.glob("*.md")):
            if f.name == "MEMORY.md":
                continue
            try:
                raw = f.read_text(errors="ignore")
            except OSError:
                continue
            meta, body = front_matter(raw)
            slug = meta.get("name") or f.stem
            mtime = dt.date.fromtimestamp(f.stat().st_mtime).isoformat()
            if args.since and mtime < args.since:
                continue
            out.append({
                "slug": slug,
                "project": label(proj.name),
                "path": decode_project(proj.name),
                "orphan": orphan,
                "type": meta.get("type", "?"),
                "desc": meta.get("description", ""),
                "body": body,
                "mtime": mtime,
                "file": f,
                "filed": slug in already,
            })
    return out


def render(items, args):
    L = []
    today = dt.date.today().isoformat()
    L.append(f"# Memory harvest — {today}\n")
    scope = "all memories" if args.all else "memories not yet referenced in ~/src/rnd"
    if args.orphans:
        scope += " (orphan/worktree namespaces only)"
    if args.since:
        scope += f", modified since {args.since}"
    L.append(f"**Scope:** {scope}  ")
    L.append(f"**Found:** {len(items)}\n")

    orphans = [i for i in items if i["orphan"]]
    if orphans:
        L.append(f"> **{len(orphans)} memory(ies) sit in worktree namespaces** and will be "
                 "lost when those worktrees are removed. Triage these first.\n")

    by_proj = {}
    for i in items:
        by_proj.setdefault(i["project"], []).append(i)

    L.append("## By project\n")
    for proj, group in sorted(by_proj.items(), key=lambda kv: -len(kv[1])):
        flag = "  ⚠️ orphan namespace" if group[0]["orphan"] else ""
        L.append(f"- **{proj}** — {len(group)}{flag}")
    L.append("")

    for proj, group in sorted(by_proj.items(), key=lambda kv: -len(kv[1])):
        L.append(f"\n---\n\n## {proj}" + ("  ⚠️ **orphan namespace**" if group[0]["orphan"] else ""))
        L.append(f"`{group[0]['path']}`\n")
        for i in sorted(group, key=lambda x: x["mtime"], reverse=True):
            L.append(f"### {i['slug']}")
            bits = [f"type: {i['type']}", f"updated: {i['mtime']}"]
            if i["filed"]:
                bits.append("**already referenced in rnd**")
            L.append("  ".join(f"_{b}_" for b in bits) + "  ")
            if i["desc"]:
                L.append(f"{i['desc']}\n")
            L.append("<details><summary>body</summary>\n")
            L.append(i["body"])
            L.append("\n</details>\n")

    L.append("\n---\n")
    L.append("## Triage checklist\n")
    L.append("For each entry above:\n")
    L.append("1. Does a `topics/` file already cover it? **Append there** — don't create a near-duplicate.")
    L.append("2. Is it repo-specific mechanics (a build flag, a local gotcha)? Leave it in that repo's memory; it isn't R&D.")
    L.append("3. Does it contradict an existing topic? Rewrite the claim, don't stack both.")
    L.append("4. Is it a decision with consequences? Promote it to `decisions/NNNN-<slug>.md`.")
    L.append("5. Orphan-namespace entries: copy anywhere durable before the worktree goes.\n")
    return "\n".join(L)


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--all", action="store_true", help="include memories already referenced in rnd")
    ap.add_argument("--orphans", action="store_true", help="only worktree namespaces")
    ap.add_argument("--since", metavar="YYYY-MM-DD", help="only memories modified on/after this date")
    ap.add_argument("-o", "--out", metavar="FILE", help="write to FILE instead of stdout")
    args = ap.parse_args()

    items = collect(args)
    text = render(items, args)
    if args.out:
        pathlib.Path(args.out).expanduser().write_text(text)
        print(f"wrote {len(items)} entry(ies) to {args.out}")
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
