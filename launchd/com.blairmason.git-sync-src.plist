<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blairmason.git-sync-src</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/blairmason/.local/bin/git-sync-src.sh</string>
    <string>--quiet</string>
  </array>
  <!-- Fetch only. Add <string>--ff</string> above to also fast-forward the
       default branch where it is checked out, clean, and undiverged. -->
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/git-sync-src.log</string>
  <key>StandardErrorPath</key><string>/tmp/git-sync-src.log</string>
</dict>
</plist>
