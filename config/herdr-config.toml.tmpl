onboarding = false
# Herdr configuration.  Validate with: herdr config check
# Full reference: herdr --default-config

[ui]
# Group the agent panel by space, so all conversations for a repo sit together.
# Trade-off vs. the old "priority": lost urgency-first ordering, kept the jump
# keys below -- next_agent/focus_agent still walk agents, just space by space.
agent_panel_sort = "spaces"

# With several claudes in one space, name the pane in its border so you can
# tell them apart without focusing each one.
show_agent_labels_on_pane_borders = true

[session]
# After a server restart, restore agent panes into their actual prior
# conversations rather than bare shells -- runs `claude --resume <id>`.
# Requires an official integration reporting a session ref; the Claude
# integration here is v7 and the docs require v6+. This is already the
# default, set explicitly so it's visible and doesn't silently change.
resume_agents_on_restore = true

[keys]
# Agent navigation ships UNBOUND by default, which hides the main reason to
# run herdr with 10-15 concurrent agents: jumping to the one that needs you.
#
#   prefix+a         next agent
#   prefix+shift+a   previous agent
#   prefix+alt+1..9  jump straight to agent N
#
# a / shift+a are free -- the defaults use ? s q o w g c p n e h j k l v x z r b
# t d and their shift variants.
next_agent = "prefix+a"
previous_agent = "prefix+shift+a"
focus_agent = "prefix+alt+1..9"

# One space per repo, so this is "switch repo". Reaches the first 9 only;
# prefix+w (workspace_picker) is the real navigation past that.
switch_workspace = "prefix+shift+1..9"

# new_cwd defaults to "follow", so a new tab inherits the SOURCE PANE's current
# directory -- which drifts once an agent enters .claude/worktrees/... A tab
# born in a worktree also gets its own Claude project namespace, orphaned when
# that worktree goes. So prefix+c is rebound below to herdr-new-tab, which
# anchors at the space's repo root; the builtin moves to prefix+shift+c.
new_tab = "prefix+shift+c"      # builtin: follows the current cwd

# Same reasoning for spaces, but the stakes are higher: a space's cwd becomes
# its permanent identity_cwd and no CLI can change it afterwards. prefix+shift+n
# is rebound below to herdr-new-space (pick a repo, anchor at its root); the
# builtin follow-the-cwd version moves to prefix+alt+n.
new_workspace = "prefix+shift+n"  # builtin: follows the current cwd

# Claude sets its terminal title to the live task; surface it in the sidebar so
# rows read by what the agent is doing, not just "backend".
[ui.sidebar.agents]
rows = [["state_icon", "workspace", "tab"], ["agent"]]

# $focus / $p / $blocked are set by herdr-tag-tab (bound to prefix+alt+... below).
# state_icon already shows what herdr DETECTS (working/idle/blocked-on-you), so
# these carry only what it can't know: your priority, and external blockers.
# First matching rule wins; unspecified style fields inherit the default.
[ui.sidebar.agents.rows_by_agent]
claude = [
  ["state_icon", "workspace", "tab"],
  ["terminal_title_stripped"],
  [{ token = "$focus", fg = "#cdd6f4", bold = true },
   { token = "$p", fg = "#9399b2", rules = [
       { equals = "p0", fg = "#f38ba8", bold = true },
       { equals = "p1", fg = "#f9e2af" },
       { equals = "p2", fg = "#6c7086", dim = true },
   ] },
   # `contains`, not `equals`: the token may be "review+them" when a tab is
   # blocked on both. First match wins, so the more urgent one leads.
   { token = "$blocked", fg = "#f38ba8", rules = [
       { contains = "review", fg = "#fab387", bold = true },
       { contains = "them",   fg = "#cba6f7", bold = true },
   ] }],
  ["agent"],
]

# Default is "off" -- without this, an agent finishing or blocking in a
# background space notifies nowhere.
[ui.toast]
delivery = "system"

# peon-ping already plays sounds via Claude hooks; herdr's would double up.
# Flip to true if you'd rather herdr own it (it distinguishes background spaces).
[ui.sound]
enabled = false

[experimental]
# Save recent pane screen history across full server restarts, so the 0.9.0
# restart brings back scrollback and not just the resumed conversations.
# Pairs with session.resume_agents_on_restore = true above.
pane_history = true

# One family, all prefix+alt+<mnemonic>:  l = label, t = tab, s = space.
# Each opens a popup; nothing else needs memorising. The herdr builtins for
# new tab / new space stay on prefix+shift+c and prefix+shift+n, and follow the
# current directory rather than anchoring at the repo root.

# Label the focused tab: multi-select over priority and blocker, plus resync.
[[keys.command]]
key = "prefix+alt+l"
type = "popup"
command = "__BIN__/herdr-tag-tab pick"
width = "72%"
height = "50%"

# New tab: name -> agent -> labels, then it's ready to talk to. A popup, not a
# detached shell, because it prompts. Skip any prompt with enter/esc.
[[keys.command]]
key = "prefix+alt+t"
type = "popup"
command = "__BIN__/herdr-new-tab"
width = "72%"
height = "60%"

# New space: pick a repo, anchored at its root.
[[keys.command]]
key = "prefix+alt+s"
type = "popup"
command = "__BIN__/herdr-new-space"
width = "70%"
height = "60%"

# Jump to a tab by what it MEANS. herdr's own indexed focus only selects by
# position (tab N, agent N), which stops being a selector at a few dozen tabs.
[[keys.command]]
key = "prefix+alt+j"
type = "popup"
command = "__BIN__/herdr-jump"
width = "80%"
height = "70%"
