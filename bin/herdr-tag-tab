#!/usr/bin/env python3
"""Tag the focused herdr tab with focus/priority/blocked state.

Two independent slots are encoded as emoji marks at the front of the tab name:

    slot 1 (focus or priority)   ⭐ focus   🔴 p0   🟡 p1   ⚪ p2
    slot 2 (blocked on)          👀 review  ✋ them

    "⭐👀 dp-140-composer"  = the current focus, blocked on a review
    "🟡 null-integrator"    = p1, not blocked

The tab NAME is the source of truth. herdr persists tab names across restarts
but not pane metadata, so `resync` rebuilds every $focus/$p/$blocked token
from the marks — see the note at the bottom of this file.

Usage:
    herdr-tag-tab focus            ⭐ exclusive: demotes any previous focus to p0
    herdr-tag-tab p0 | p1 | p2     set priority, drops ⭐ from this tab
    herdr-tag-tab review | them    mark what it's blocked on
    herdr-tag-tab unblock          clear slot 2, keep priority
    herdr-tag-tab clear            clear both slots and all tokens
    herdr-tag-tab resync           rebuild tokens from marks on every tab
"""
import json
import re
import shutil
import subprocess
import sys

FOCUS = "⭐"
PRIORITY = {"p0": "\U0001F534", "p1": "\U0001F7E1", "p2": "⚪"}
BLOCKED = {"review": "\U0001F440", "them": "✋"}

PRIORITY_BY_MARK = {m: p for p, m in PRIORITY.items()}
BLOCKED_BY_MARK = {m: b for b, m in BLOCKED.items()}

SLOT1 = FOCUS + "".join(PRIORITY.values())
SLOT2 = "".join(BLOCKED.values())
# Marks are position-significant: slot 1 then slot 2, then the real name.
MARKS_RE = re.compile(r"^([" + SLOT1 + r"]?)([" + SLOT2 + r"]?)\s*(.*)$", re.S)


def herdr(*args, capture=True):
    r = subprocess.run(["herdr", *args], capture_output=capture, text=True)
    return r.stdout if capture else ""


def jget(*args):
    try:
        return json.loads(herdr(*args))["result"]
    except (ValueError, KeyError):
        return None


def split_marks(label):
    """-> (slot1_mark, slot2_mark, bare_name)"""
    m = MARKS_RE.match(label or "")
    return (m.group(1), m.group(2), m.group(3).strip()) if m else ("", "", label or "")


def all_tabs():
    spaces = (jget("workspace", "list") or {}).get("workspaces", [])
    out = []
    for w in spaces:
        tabs = (jget("tab", "list", "--workspace", w["workspace_id"]) or {}).get("tabs", [])
        out.extend(tabs)
    return out


def focused_tab_id():
    spaces = (jget("workspace", "list") or {}).get("workspaces", [])
    f = next((w for w in spaces if w.get("focused")), None)
    return f.get("active_tab_id") if f else None


def panes_of(tab_id):
    panes = (jget("pane", "list") or {}).get("panes", [])
    return [p["pane_id"] for p in panes if p.get("tab_id") == tab_id]


def write_tokens(tab_id, slot1, slot2):
    """Make pane tokens match the marks. Cleared tokens are omitted, not blanked."""
    focus = "NOW" if slot1 == FOCUS else None
    # Values stay as "p0"/"p1"/"p2" and are matched with `equals` rules --
    # numeric gt/lt rules would depend on herdr coercing a string token value.
    prio = "p0" if slot1 == FOCUS else PRIORITY_BY_MARK.get(slot1)
    blocked = BLOCKED_BY_MARK.get(slot2)

    for pid in panes_of(tab_id):
        args = ["pane", "report-metadata", pid, "--source", "herdr-tag-tab"]
        for name, val in (("focus", focus), ("p", prio), ("blocked", blocked)):
            args += ["--token", f"{name}={val}"] if val else ["--clear-token", name]
        herdr(*args, capture=False)


def apply(tab_id, label, slot1=None, slot2=None):
    cur1, cur2, bare = split_marks(label)
    new1 = cur1 if slot1 is None else slot1
    new2 = cur2 if slot2 is None else slot2
    name = f"{new1}{new2} {bare}".strip() or bare or tab_id.split(":")[-1]
    herdr("tab", "rename", tab_id, name, capture=False)
    write_tokens(tab_id, new1, new2)
    return name


def resync_all():
    n = 0
    for t in all_tabs():
        s1, s2, _ = split_marks(t.get("label", ""))
        if s1 or s2:
            write_tokens(t["tab_id"], s1, s2)
            n += 1
    return n


def set_focus_exclusive(tab_id):
    """Take the star off whatever holds it, demoting that tab to p0."""
    for t in all_tabs():
        if t["tab_id"] == tab_id:
            continue
        s1, s2, _ = split_marks(t.get("label", ""))
        if s1 == FOCUS:
            apply(t["tab_id"], t["label"], slot1=PRIORITY["p0"], slot2=s2)


# (display, slot, value) -- slot 1 is focus/priority, slot 2 is the blocker.
MENU = [
    (f"{FOCUS}  focus          — the one thing that matters now", 1, FOCUS),
    (f"{PRIORITY['p0']}  p0             — next up", 1, PRIORITY["p0"]),
    (f"{PRIORITY['p1']}  p1", 1, PRIORITY["p1"]),
    (f"{PRIORITY['p2']}  p2             — background", 1, PRIORITY["p2"]),
    (f"{BLOCKED['review']}  blocked        — waiting on a review", 2, BLOCKED["review"]),
    (f"{BLOCKED['them']}  blocked        — waiting on someone", 2, BLOCKED["them"]),
    ("·  clear priority", 1, ""),
    ("·  clear blocked", 2, ""),
    ("↻  resync all tabs — after a restart, rebuild colours from the marks", 0, None),
]


def describe(slot1, slot2):
    bits = []
    if slot1 == FOCUS:
        bits.append("⭐ focus")
    elif slot1 in PRIORITY_BY_MARK:
        bits.append(f"{slot1} {PRIORITY_BY_MARK[slot1]}")
    if slot2:
        bits.append(f"{slot2} blocked:{BLOCKED_BY_MARK.get(slot2, '?')}")
    return "  ".join(bits) if bits else "untagged"


def pick(tab_id, label):
    """Popup multi-select: choose one from either slot, or both, or neither."""
    cur1, cur2, bare = split_marks(label)
    header = f"{bare or tab_id}\nnow: {describe(cur1, cur2)}   ·   tab/space to multi-select, enter to apply"

    lines = [d for d, _, _ in MENU]
    if shutil.which("fzf"):
        proc = subprocess.run(
            ["fzf", "--multi", "--reverse", "--height=100%",
             "--prompt=label> ", "--header", header],
            input="\n".join(lines), capture_output=True, text=True)
        chosen = [l for l in proc.stdout.splitlines() if l.strip()]
        if proc.returncode not in (0,) and not chosen:
            return 130
    else:
        print(header + "\n")
        for i, d in enumerate(lines, 1):
            print(f"{i:2}. {d}")
        try:
            raw = input("\nnumbers (comma-separated, blank to cancel)> ").strip()
        except (EOFError, KeyboardInterrupt):
            return 130
        if not raw:
            return 130
        chosen = []
        for part in raw.split(","):
            try:
                chosen.append(lines[int(part.strip()) - 1])
            except (ValueError, IndexError):
                print(f"ignoring: {part.strip()}", file=sys.stderr)

    by_display = {d: (slot, val) for d, slot, val in MENU}
    slot1 = slot2 = None
    do_resync = False
    for c in chosen:
        hit = by_display.get(c)
        if not hit:
            continue
        slot, val = hit
        if slot == 0:
            do_resync = True
            continue
        # First pick per slot wins; the slots are mutually exclusive internally.
        if slot == 1 and slot1 is None:
            slot1 = val
        elif slot == 2 and slot2 is None:
            slot2 = val

    if do_resync:
        print(f"resynced {resync_all()} tagged tab(s)")
    if slot1 is None and slot2 is None:
        return 0 if do_resync else 130
    if slot1 == FOCUS:
        set_focus_exclusive(tab_id)
    print(apply(tab_id, label, slot1=slot1, slot2=slot2))
    return 0


def main():
    argv = sys.argv[1:]
    # --tab <id> targets a specific tab instead of whatever is focused, so a
    # caller can label a tab it just created without stealing focus first.
    explicit = None
    if "--tab" in argv:
        i = argv.index("--tab")
        if i + 1 < len(argv):
            explicit = argv[i + 1]
            del argv[i:i + 2]
    cmd = (argv[0] if argv else "").strip().lower()

    if cmd == "resync":
        print(f"resynced {resync_all()} tagged tab(s)")
        return 0

    tab_id = explicit or focused_tab_id()
    if not tab_id:
        print("no focused tab", file=sys.stderr)
        return 1
    tab = (jget("tab", "get", tab_id) or {}).get("tab", {})
    label = tab.get("label", "")

    if cmd in ("pick", ""):
        return pick(tab_id, label)
    if cmd == "focus":
        set_focus_exclusive(tab_id)
        print(apply(tab_id, label, slot1=FOCUS))
    elif cmd in PRIORITY:
        print(apply(tab_id, label, slot1=PRIORITY[cmd]))
    elif cmd in BLOCKED:
        print(apply(tab_id, label, slot2=BLOCKED[cmd]))
    elif cmd == "unblock":
        print(apply(tab_id, label, slot2=""))
    elif cmd == "clear":
        print(apply(tab_id, label, slot1="", slot2=""))
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
